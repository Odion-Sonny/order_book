DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
REDIS_URL=redis://localhost:6379/0

# Set to True to use Redis for channel layers (needed for cross-process streaming)
REDIS_CHANNEL_LAYER=False

# Both key and secret are required; with only one set every bar request comes back empty
ALPACA_API_KEY=your-alpaca-key
ALPACA_API_SECRET=your-alpaca-secret
ALPACA_API_BASE_URL=https://paper-api.alpaca.markets

# Free accounts only have IEX; sip requires a paid market-data subscription
ALPACA_DATA_FEED=iex
