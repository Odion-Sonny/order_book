#!/usr/bin/env bash
# Run alpaca-cli using the credentials already in trading_engine/.env,
# so the secret lives in exactly one place.
#
#   ./scripts/alpaca quote AAPL
#   ./scripts/alpaca data stock bars AAPL -t 1Day --limit 5
#   ./scripts/alpaca config verify
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_FILE="$ROOT/trading_engine/.env"
CLI="${ALPACA_CLI:-$HOME/.venvs/order_book/bin/alpaca-cli}"

if [[ ! -f "$ENV_FILE" ]]; then
    echo "Missing $ENV_FILE - copy trading_engine/.env.example and add your keys." >&2
    exit 1
fi

set -a
# shellcheck disable=SC1090
. "$ENV_FILE"
set +a

if [[ -z "${ALPACA_API_KEY:-}" || -z "${ALPACA_API_SECRET:-}" ]]; then
    echo "ALPACA_API_KEY / ALPACA_API_SECRET are not both set in $ENV_FILE." >&2
    exit 1
fi

# alpaca-cli reads the APCA_* names used by Alpaca's own tooling.
export APCA_API_KEY_ID="$ALPACA_API_KEY"
export APCA_API_SECRET_KEY="$ALPACA_API_SECRET"

exec "$CLI" "$@"
